{
  "expo": {
    "name": "Lightweight PDF Scanner",
    "slug": "lightweight-pdf-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lightweightscanner",
    "userInterfaceStyle": "dark",
    "jsEngine": "hermes",
    "ios": {
      "bundleIdentifier": "com.lightweight.pdfscanner",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikasi ini memerlukan akses ke kamera untuk memindai dokumen fisik ke format PDF berkualitas tinggi."
      }
    },
    "android": {
      "package": "com.lightweight.pdfscanner",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "react-native-document-scanner-plugin",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "targetSdkVersion": 35,
            "compileSdkVersion": 35,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "abiFilters": [
              "arm64-v8a"
            ],
            "extraProguardRules": "-dontwarn com.google.**\n-dontwarn org.opencv.**\n-ignorewarnings\n-keep class com.documentscanner.** { *; }\n-keepclassmembers class com.documentscanner.** { *; }\n-keep class com.google.android.gms.** { *; }\n-renamesourcefileattribute SourceFile\n-assumenosideeffects class android.util.Log { public static boolean isLoggable(java.lang.String, int); public static int v(...); public static int d(...); public static int i(...); public static int w(...); public static int e(...); }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c4758bd7-80f0-40de-8f70-a3f0c16800da"
      }
    }
  }
}
